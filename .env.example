# Copy to .env.local. Use placeholders here only. Never commit real keys.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key, or the legacy anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Supabase secret key, or the legacy service_role key. Server only.
SUPABASE_SECRET_KEY=your_secret_key

# Razorpay TEST keys in development. Use LIVE keys only in production.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
